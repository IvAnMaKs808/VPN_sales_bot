# ============================================================
#  VPN BOT — файл настроек. Скопируй в .env и заполни значения.
#  cp .env.example .env
# ============================================================

# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Твой Telegram ID (узнать: @userinfobot). Можно несколько через запятую.
ADMIN_IDS=123456789
# Юзернейм для кнопки "Поддержка" (без @)
SUPPORT_USERNAME=your_support_username

# --- 3x-ui панель ---
# Полный адрес панели вместе с web base path, БЕЗ слэша в конце
# Пример: https://panel.example.com:2053/abcdef
XUI_BASE_URL=https://your-panel-domain:2053/yourbasepath
XUI_USERNAME=admin
XUI_PASSWORD=admin
# ID инбаунда (VLESS Reality), в который добавляем клиентов. Посмотри в панели.
XUI_INBOUND_ID=1
# Базовый URL подписки (Subscription) из настроек панели, БЕЗ слэша в конце.
# Именно эту ссылку + /{subId} мы отдаём пользователю для Happ.
# Пример: https://panel.example.com:2096/sub
XUI_SUB_BASE_URL=https://your-panel-domain:2096/sub
# flow для VLESS Reality (обычно xtls-rprx-vision)
XUI_FLOW=xtls-rprx-vision

# --- ЮKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Ссылка возврата после оплаты (можно ссылку на бота)
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# --- CryptoBot (@CryptoBot -> Crypto Pay -> Create App) ---
CRYPTOBOT_TOKEN=
# Валюта фиатного эквивалента для крипты (RUB/USD). Сумма берётся из тарифа в RUB.
CRYPTOBOT_FIAT=RUB

# --- Бизнес-логика ---
# Пробный период в днях (0 = выключить триал)
TRIAL_DAYS=3
# Реферальный процент возврата (на баланс), 30 = 30%
REFERRAL_PERCENT=30
# Сколько дней подписки получает пригласивший за каждого приглашённого (при первой оплате реферала)
REFERRAL_BONUS_DAYS=10
# Лимит трафика на клиента в ГБ (0 = безлимит)
TRAFFIC_LIMIT_GB=0

# --- База данных ---
DB_PATH=vpnbot.db
